APP_NAME="Autenticador Macroambiental"
APP_ENV="development"
DEBUG="false"
# Producao: firebase e obrigatorio, sem fallback em memoria.
AUTH_STORAGE_MODE="firebase"
FIREBASE_PROJECT_ID="SEU_FIREBASE_PROJECT_ID"
FIREBASE_STORAGE_BUCKET="SEU_BUCKET_FIREBASE"
# Necessario para validar token Firebase no backend:
# 1) Credencial de service account (GOOGLE_APPLICATION_CREDENTIALS)
# 2) Project ID resolvivel (FIREBASE_PROJECT_ID ou GOOGLE_CLOUD_PROJECT)
# GOOGLE_APPLICATION_CREDENTIALS="/caminho/credencial-service-account.json"
# GOOGLE_CLOUD_PROJECT="SEU_FIREBASE_PROJECT_ID"
# Manter essa chave confidencial e igual no backend de Equipamentos.
INTEGRATION_API_KEY="CHAVE_ALEATORIA_LONGA_GERADA_POR_GESTOR_DE_SEGREDOS"
ADMIN_API_KEY="OUTRA_CHAVE_ALEATORIA_INDEPENDENTE_E_LONGA"
VERIFICATION_BASE_URL="https://SEU_FRONTEND_AUTENTICADOR"
CORS_ORIGINS="https://SEU_FRONTEND_AUTENTICADOR,https://SEU_FRONTEND_EQUIPAMENTOS"
TI_ALLOWED_EMAILS="ti1@empresa.com,ti2@empresa.com"
# Para testes LOCAIS: AUTH_STORAGE_MODE=local, nunca em producao.
AUTH_LOCAL_DIR="./local_auth_data"
MAX_PDF_BYTES=12000000
